<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ديوان أوتاري</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Noto+Kufi+Arabic:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0d0f14;
            --card-bg: #151821;
            --gold: #d4af37;
            --border-gold: rgba(212, 175, 55, 0.45);
            --text-main: #f0f2f5;
            --text-muted: #9aa1ad;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'IBM Plex Sans Arabic', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            padding-bottom: 50px;
        }

        header {
            text-align: center;
            padding: 15px;
            background: radial-gradient(circle at 50% 30%, rgba(212, 175, 55, 0.2) 0%, rgba(13, 15, 20, 0) 70%);
            border-bottom: 1px solid var(--border-gold);
        }

        .logo-title {
            font-family: 'Noto Kufi Arabic', sans-serif;
            color: var(--gold);
            font-size: 1.7rem;
            font-weight: 800;
            margin-top: 8px;
        }

        .container {
            max-width: 800px;
            margin: 15px auto;
            padding: 0 15px;
        }

        /* شريط التحكم مع السهم */
        .admin-toggle-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #12151d;
            border: 1.5px solid var(--gold);
            border-radius: 10px;
            padding: 12px 18px;
            margin-bottom: 15px;
            cursor: pointer;
        }

        .admin-toggle-title {
            color: var(--gold);
            font-size: 1rem;
            font-weight: 700;
            font-family: 'Noto Kufi Arabic', sans-serif;
        }

        .toggle-arrow {
            color: var(--gold);
            font-size: 1.1rem;
            font-weight: bold;
            transition: transform 0.3s ease;
        }

        /* صندوق الإضافة والتعديل */
        .admin-box {
            background: #12151d;
            border: 1.5px solid var(--gold);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: var(--gold);
            font-size: 0.9rem;
            font-weight: 700;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px;
            background: #080a0f;
            border: 1px solid var(--border-gold);
            border-radius: 6px;
            color: #fff;
            font-size: 0.95rem;
            outline: none;
        }

        .form-group textarea {
            height: 100px;
        }

        .save-btn {
            width: 100%;
            padding: 12px;
            background: var(--gold);
            color: #000;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
        }

        .breadcrumb {
            margin-bottom: 12px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .breadcrumb span {
            color: var(--gold);
            cursor: pointer;
            text-decoration: underline;
            font-weight: 600;
        }

        /* الأزرار والقوائم */
        .grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .card {
            background: var(--card-bg);
            border: 1.5px solid var(--border-gold);
            border-radius: 10px;
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: right;
            width: 100%;
            color: #fff;
        }

        .card-main-info {
            display: flex;
            align-items: center;
            cursor: pointer;
            flex-grow: 1;
        }

        .card-title {
            font-size: 1.15rem;
            font-weight: 700;
            font-family: 'Noto Kufi Arabic', sans-serif;
        }

        .card-desc {
            font-size: 0.85rem;
            color: var(--gold);
            margin-top: 4px;
            font-weight: 600;
        }

        .card-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .action-btn {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            border: none;
        }

        .edit-btn {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.4);
        }

        .delete-btn {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.4);
        }

        .arrow {
            color: var(--gold);
            font-size: 1.2rem;
            background: rgba(212, 175, 55, 0.15);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid var(--border-gold);
            font-weight: bold;
            flex-shrink: 0;
            cursor: pointer;
            margin-right: 8px;
        }

        .lyrics-box {
            background: var(--card-bg);
            border: 1px solid var(--border-gold);
            border-radius: 10px;
            padding: 20px;
        }

        .lyrics-content {
            font-size: 1.2rem;
            line-height: 2;
            white-space: pre-line;
            text-align: center;
            color: #e5e7eb;
        }

        .section-title {
            text-align: center;
            color: var(--gold);
            font-family: 'Noto Kufi Arabic', sans-serif;
            margin-bottom: 5px;
            font-size: 1.3rem;
        }

        .section-type-badge {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        .back-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-gold);
            color: var(--gold);
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            margin-bottom: 15px;
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-title">ديوان أوتاري</div>
    </header>

    <div class="container">

        <div class="breadcrumb" id="breadcrumb" onclick="showHome()">
            <span>الرئيسية</span>
        </div>

        <!-- شريط التحكم مع السهم -->
        <div class="admin-toggle-bar" id="toggle-bar" onclick="toggleAdminBox()">
            <span class="admin-toggle-title" id="form-mode-title">⚙️ لوحة الإضافة للديوان</span>
            <span class="toggle-arrow" id="toggle-arrow-icon">▲</span>
        </div>

        <!-- صندوق الإضافة والتعديل -->
        <div class="admin-box" id="admin-box">
            <form onsubmit="saveWork(event)">
                <input type="hidden" id="edit-index" value="-1">
                <div class="form-group">
                    <label>المقام:</label>
                    <select id="inp-maqam">
                        <option value="bayati">مقام البيات</option>
                        <option value="saba">مقام الصبا</option>
                        <option value="nahawand">مقام النهاوند</option>
                        <option value="ajam">مقام العجم</option>
                        <option value="dabkat">دبكات</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>نوع العمل:</label>
                    <select id="inp-type">
                        <option value="موشح">موشح</option>
                        <option value="قد">قد</option>
                        <option value="دبكة">دبكة</option>
                        <option value="إنشاد">إنشاد</option>
                        <option value="قصيدة">قصيدة</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>عنوان العمل (اسم الأغنية أو الموشح):</label>
                    <input type="text" id="inp-title" required placeholder="مثال: يا مال الشام">
                </div>
                <div class="form-group">
                    <label>الكلمات:</label>
                    <textarea id="inp-lyrics" required placeholder="اكتب الكلمات هنا..."></textarea>
                </div>
                <button type="submit" class="save-btn" id="submit-btn-text">حفظ وإضافة ✓</button>
            </form>
        </div>

        <!-- القائمة الرئيسية -->
        <div id="screen-home" class="grid">
            <button class="card" onclick="openMaqam('saba')">
                <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                    <div>
                        <div class="card-title">مقام الصبا</div>
                        <div class="card-desc">نغم الشجن والعاطفة</div>
                    </div>
                    <div class="arrow">←</div>
                </div>
            </button>

            <button class="card" onclick="openMaqam('nahawand')">
                <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                    <div>
                        <div class="card-title">مقام النهاوند</div>
                        <div class="card-desc">نغم الرقة والشوق</div>
                    </div>
                    <div class="arrow">←</div>
                </div>
            </button>

            <button class="card" onclick="openMaqam('ajam')">
                <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                    <div>
                        <div class="card-title">مقام العجم</div>
                        <div class="card-desc">نغم البهجة والفرح</div>
                    </div>
                    <div class="arrow">←</div>
                </div>
            </button>

            <button class="card" onclick="openMaqam('bayati')">
                <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                    <div>
                        <div class="card-title">مقام البيات</div>
                        <div class="card-desc">أصل التراث الشعبي</div>
                    </div>
                    <div class="arrow">←</div>
                </div>
            </button>

            <button class="card" onclick="openMaqam('dabkat')">
                <div style="display:flex; justify-content:space-between; width:100%; align-items:center;">
                    <div>
                        <div class="card-title">🔥 دبكات وأهازيج</div>
                        <div class="card-desc">أهازيج شعبية وعراضات</div>
                    </div>
                    <div class="arrow">←</div>
                </div>
            </button>
        </div>

        <!-- شاشة الوصلات -->
        <div id="screen-waslat" class="grid hidden"></div>

        <!-- شاشة الكلمات -->
        <div id="screen-lyrics" class="hidden">
            <button class="back-btn" onclick="backToWaslat()">← رجوع</button>
            <div class="lyrics-box">
                <div class="section-title" id="lyric-title-display"></div>
                <div class="section-type-badge" id="lyric-type-display"></div>
                <div class="lyrics-content" id="lyric-text-display"></div>
            </div>
        </div>

    </div>

    <script>
        let database = {
            saba: { name: "مقام الصبا", items: [ { type: "موشح", title: "غضي جفونك يا عيون", lyrics: "غُضِّي جُفُونَكِ يَا عُيُونُ .. وَكَفْكِفِي دَمْعَ الهَوَانْ" } ] },
            nahawand: { name: "مقام النهاوند", items: [ { type: "موشح", title: "يا بهجة الروح", lyrics: "يَا بَهْجَةَ الرُّوحِ جُودِي .. وَأَنْعِمِي بِالوِصَالِ" } ] },
            ajam: { name: "مقام العجم", items: [ { type: "طقطوقة", title: "طلعت يا محلا نورها", lyrics: "طَلَعَتْ يَا مَحْلَا نُورْهَا .. شَمْسِ الشُّمُوسَة" } ] },
            bayati: { name: "مقام البيات", items: [ { type: "قد", title: "يا مال الشام", lyrics: "يَا مَالِ الشَّامْ يَا الله يَا مَالِي .. طَالَ المَطَالْ" } ] },
            dabkat: { name: "دبكات", items: [ { type: "دبكة", title: "يا حلالي يا مالي", lyrics: "يَا حَلَالِي يَا مَالِي .. يَا أَبُو لِحَافٍ طَيَّة" } ] }
        };

        let currentMaqam = null;

        function toggleAdminBox() {
            let box = document.getElementById('admin-box');
            let arrow = document.getElementById('toggle-arrow-icon');
            if (box.classList.contains('hidden')) {
                box.classList.remove('hidden');
                arrow.innerText = "▲";
            } else {
                box.classList.add('hidden');
                arrow.innerText = "▼";
            }
        }

        function saveWork(e) {
            e.preventDefault();
            let mKey = document.getElementById('inp-maqam').value;
            let type = document.getElementById('inp-type').value;
            let title = document.getElementById('inp-title').value;
            let lyrics = document.getElementById('inp-lyrics').value;
            let editIdx = parseInt(document.getElementById('edit-index').value);

            if(!database[mKey]) database[mKey] = { name: mKey, items: [] };

            if(editIdx === -1) {
                database[mKey].items.push({ type: type, title: title, lyrics: lyrics });
                alert("✓ تم إضافة العمل بنجاح!");
            } else {
                database[mKey].items[editIdx] = { type: type, title: title, lyrics: lyrics };
                document.getElementById('edit-index').value = "-1";
                document.getElementById('form-mode-title').innerText = "⚙️ لوحة الإضافة للديوان";
                document.getElementById('submit-btn-text').innerText = "حفظ وإضافة ✓";
                alert("✓ تم تعديل العمل بنجاح!");
            }

            document.getElementById('inp-title').value = '';
            document.getElementById('inp-lyrics').value = '';

            openMaqam(mKey);
        }

        function editWork(key, idx, event) {
            event.stopPropagation();
            let item = database[key].items[idx];
            
            document.getElementById('inp-maqam').value = key;
            document.getElementById('inp-type').value = item.type;
            document.getElementById('inp-title').value = item.title;
            document.getElementById('inp-lyrics').value = item.lyrics;
            document.getElementById('edit-index').value = idx;

            document.getElementById('form-mode-title').innerText = "✏️ تعديل العمل الحالي";
            document.getElementById('submit-btn-text').innerText = "حفظ التعديلات ✓";

            let box = document.getElementById('admin-box');
            let arrow = document.getElementById('toggle-arrow-icon');
            box.classList.remove('hidden');
            arrow.innerText = "▲";

            showHome();
        }

        function deleteWork(key, idx, event) {
            event.stopPropagation();
            if(confirm("هل أنت متأكد من حذف هذا العمل؟")) {
                database[key].items.splice(idx, 1);
                alert("🗑️ تم الحذف بنجاح!");
                openMaqam(key);
            }
        }

        function openMaqam(key) {
            currentMaqam = key;
            let maqam = database[key] || { name: key, items: [] };
            let container = document.getElementById('screen-waslat');
            
            let html = '';
            if(maqam.items.length > 0) {
                maqam.items.forEach((item, idx) => {
                    html += `
                        <div class="card">
                            <div class="card-main-info" onclick="openLyrics('${key}', ${idx})">
                                <div>
                                    <div class="card-title">${item.title}</div>
                                    <div class="card-desc">[ ${item.type} ]</div>
                                </div>
                            </div>
                            <div class="card-actions">
                                <button class="action-btn edit-btn" onclick="editWork('${key}', ${idx}, event)">تعديل</button>
                                <button class="action-btn delete-btn" onclick="deleteWork('${key}', ${idx}, event)">حذف</button>
                                <div class="arrow" onclick="openLyrics('${key}', ${idx})">←</div>
                            </div>
                        </div>
                    `;
                });
            } else {
                html = '<div style="text-align:center; color: var(--text-muted); padding:20px;">لا توجد أعمال مضافة هنا بعد.</div>';
            }

            container.innerHTML = html;
            document.getElementById('screen-home').classList.add('hidden');
            document.getElementById('screen-waslat').classList.remove('hidden');
            document.getElementById('screen-lyrics').classList.add('hidden');
            document.getElementById('toggle-bar').classList.add('hidden');
            document.getElementById('admin-box').classList.add('hidden');
            document.getElementById('breadcrumb').innerHTML = `<span>الرئيسية</span> / <b>${maqam.name}</b>`;
        }

        function openLyrics(key, idx) {
            let item = database[key].items[idx];
            document.getElementById('lyric-title-display').innerText = item.title;
            document.getElementById('lyric-type-display').innerText = `تصنيف العمل: ${item.type}`;
            document.getElementById('lyric-text-display').innerText = item.lyrics;

            document.getElementById('screen-home').classList.add('hidden');
            document.getElementById('screen-waslat').classList.add('hidden');
            document.getElementById('screen-lyrics').classList.remove('hidden');
            document.getElementById('toggle-bar').classList.add('hidden');
            document.getElementById('admin-box').classList.add('hidden');
        }

        function backToWaslat() {
            if(currentMaqam) openMaqam(currentMaqam);
            else showHome();
        }

        function showHome() {
            document.getElementById('screen-home').classList.remove('hidden');
            document.getElementById('screen-waslat').classList.add('hidden');
            document.getElementById('screen-lyrics').classList.add('hidden');
            document.getElementById('toggle-bar').classList.remove('hidden');
            document.getElementById('admin-box').classList.remove('hidden');
            document.getElementById('breadcrumb').innerHTML = `<span>الرئيسية</span>`;
        }
    </script>
</body>
</html>
